{
  "name": "kai-media",
  "compatibility_date": "2026-03-04",
  "assets": {
    "directory": "./",
    "exclude": [
      "node_modules",
      "tina",
      "content",
      ".github",
      ".env",
      ".env.*",
      "*.log",
      "*.md",
      "package.json",
      "package-lock.json",
      "tina-lock.json",
      "wrangler.jsonc",
      ".gitignore"
    ]
  },
  "vars": {
    "ENVIRONMENT": "production"
  }
}
